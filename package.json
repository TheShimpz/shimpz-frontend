{
  "name": "@shimpz/frontend",
  "version": "0.2.0",
  "description": "Public Shimpz design tokens and Svelte presentation primitives",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheShimpz/shimpz-frontend.git"
  },
  "homepage": "https://github.com/TheShimpz/shimpz-frontend#readme",
  "bugs": {
    "url": "https://github.com/TheShimpz/shimpz-frontend/issues"
  },
  "type": "module",
  "files": [
    "src/lib"
  ],
  "svelte": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./tokens.css": "./src/lib/tokens.css",
    "./theme.css": "./src/lib/theme.css",
    "./assets/shimpz-thinking.svg": "./src/lib/assets/shimpz-thinking.svg",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/tokens.css",
    "./dist/theme.css"
  ],
  "scripts": {
    "dev": "vite dev",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-package && vite build",
    "build:package": "svelte-package",
    "build:showcase": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:package": "node tests/package-consumer.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.9.0",
  "peerDependencies": {
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.13.3",
    "svelte": "5.56.8",
    "svelte-check": "4.7.3",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  }
}
